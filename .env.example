# DataShield-PDP Environment Configuration

# Cryptographic Salt for Deterministic Pseudonymization (Keep secret in production!)
DATASHIELD_SALT_KEY=super-secret-cryptographic-salt-change-in-prod-2026

# Database Paths
RAW_DB_PATH=data/raw/ecommerce_raw.db
